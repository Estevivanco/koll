POSTGRES_USER=koll
POSTGRES_PASSWORD=choose-a-password
POSTGRES_DB=koll
DATABASE_URL=postgres://koll:choose-a-password@localhost:5432/koll

GOOGLE_CLOUD_PROJECT=koll-xxxxxx
VERTEX_REGION=global
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# Optional: a smaller, faster model just for the router. Leave out to use GEMINI_MODEL
# ROUTER_MODEL=

# Read-only login for the analyst agent (created by db/init/01-analyst-role.sh)
ANALYST_DB_PASSWORD=choose-another-password
ANALYST_DATABASE_URL=postgres://analyst_ro:choose-another-password@localhost:5432/koll

# Daily cap on Gemini calls, counted by db/init/02-budget-role.sh (@koll/budget)
GEMINI_DAILY_LIMIT=100
BUDGET_DB_PASSWORD=choose-a-third-password
BUDGET_DATABASE_URL=postgres://budget_rw:choose-a-third-password@localhost:5432/koll
