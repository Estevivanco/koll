{
    // The website runs in a browser, so it does not extend the Node-oriented tsconfig.base.json
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": ["vite/client"]
    },
    "include": ["src", "vite.config.ts"]
}
